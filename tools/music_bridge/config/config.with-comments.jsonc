{
  // Мост слушает все сетевые интерфейсы, чтобы устройство его нашло.
  // Порт 8765 нужно разрешить в Windows Firewall.
  "listen_host": "0.0.0.0",
  "listen_port": 8765,

  // Параметры итогового MP3.
  "mp3_bitrate": "160k",
  "keep_wav": false,

  // Провайдер, выбранный в окне моста. Обычно меняется через список
  // провайдеров в EXE; это значение используется при запуске.
  // Player volume, from 0 to 100 percent.
  "volume_percent": 70,

  "active_provider": "yue2"
}
